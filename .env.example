# Supabase project (region Frankfurt). Values: Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only, never prefixed with NEXT_PUBLIC_: used by the REST API, webhooks and cron.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Random string (min. 16 characters); Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=replace-with-a-long-random-string

# Local database tests (pnpm test:db), e.g. against `supabase start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
